    {
      "name": "5. Attachments",
      "item": [
        {
          "name": "Upload Attachment - Employee",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employee_access}}" }] },
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/attachments/", "host": ["{{base_url}}"], "path": ["api","tasks","{{task_id}}","attachments",""] }
