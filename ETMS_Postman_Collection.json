            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_access}}" }] },
            "url": { "raw": "{{base_url}}/api/comments/{{comment_id}}/", "host": ["{{base_url}}"], "path": ["api","comments","{{comment_id}}",""] }
